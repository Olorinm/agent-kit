{
  "name": "@olorinm/agent-environment",
  "version": "0.2.0-alpha.1",
  "description": "OMA sandbox implementation with Alibaba and Volcengine environment adapters",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE",
    "docs",
    "examples",
    "scripts/private-tcp-forward.mjs",
    "upstream.json",
    "LICENSE.original-components",
    "patches"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox/index.d.ts",
      "import": "./dist/sandbox/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    }
  },
  "bin": {
    "agent-environment": "dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && vitest run && node --test test/*.test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:oma": "vitest run",
    "probe": "npm run build && node scripts/probe.mjs",
    "prepack": "npm run build",
    "check:upstream": "node scripts/check-upstream.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@connectrpc/connect": "2.0.0-rc.3",
    "openapi-fetch": "0.14.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "esbuild": "0.28.0",
    "vitest": "4.1.11",
    "e2b": "2.24.0"
  },
  "private": true
}
