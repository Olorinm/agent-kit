{
  "name": "@olorinm/agent-environment",
  "version": "0.3.0-alpha.1",
  "description": "Cloud execution environments for agents, with a Cloudflare provider",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Olorinm/agent-kit.git",
    "directory": "packages/environment"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE",
    "docs",
    "examples",
    "cloudflare/src",
    "cloudflare/backup/src",
    "cloudflare/backup/scripts/*.py",
    "cloudflare/examples",
    "cloudflare/README.md",
    "cloudflare/package.json",
    "cloudflare/package-lock.json",
    "cloudflare/tsconfig.json",
    "cloudflare/wrangler.example.jsonc",
    "cloudflare/backup/wrangler.example.jsonc"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace/index.d.ts",
      "import": "./dist/workspace/index.js"
    }
  },
  "bin": {
    "agent-environment": "dist/cli.js"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "probe": "npm run build && node scripts/probe.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
