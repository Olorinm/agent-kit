{
  "name": "@agent-router/server",
  "version": "0.10.0-alpha.3",
  "private": true,
  "description": "Message router for agents: accounts, channel connections, an owner ledger and task delivery to running agents.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Olorinm/agent-kit.git",
    "directory": "packages/router"
  },
  "homepage": "https://github.com/Olorinm/agent-kit/tree/main/packages/router#readme",
  "bugs": {
    "url": "https://github.com/Olorinm/agent-kit/issues"
  },
  "keywords": [
    "agents",
    "message-router",
    "chat-channels",
    "feishu",
    "telegram",
    "weixin"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/service/main.ts",
    "start": "node dist/service/main.js",
    "agent:service": "node dist/service/main.js",
    "weixin:login": "node dist/channels/weixin/login.js",
    "feishu:setup": "node dist/services/feishu/setup.js",
    "channels:check": "node dist/service/check-cli.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "aws4fetch": "^1.0.20",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "grammy": "1.46.0",
    "jose": "^6.2.17",
    "qrcode-terminal": "0.12.0",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "docs/guides/*.md",
    "docs/architecture/communication-layer.md",
    "README.md",
    "LICENSE",
    "src",
    "scripts/update-weixin-transport.py",
    "scripts/verify-native-sessions.mjs",
    "scripts/fixtures/native-sessions-server.mjs",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  }
}
