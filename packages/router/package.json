{
  "name": "@agent-router/server",
  "version": "0.8.0-alpha.2",
  "private": true,
  "description": "Message router for agents: accounts, channel connections, an owner ledger and task delivery to running agents.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Olorinm/agent-kit.git",
    "directory": "packages/router"
  },
  "homepage": "https://github.com/Olorinm/agent-kit/tree/main/packages/router#readme",
  "bugs": {
    "url": "https://github.com/Olorinm/agent-kit/issues"
  },
  "keywords": [
    "agent-communication",
    "agent-to-agent",
    "matrix",
    "a2a",
    "cli",
    "federation"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/matrix/index.ts",
    "start": "node dist/matrix/index.js",
    "matrix:connect": "node dist/matrix/index.js",
    "matrix:demo-agent": "node dist/matrix/demo-agent.js",
    "matrix:lab:init": "node scripts/matrix/lab-init.mjs",
    "matrix:lab:check": "node scripts/matrix/lab-check.mjs",
    "cli": "./bin/agent-router",
    "build:cli": "sh scripts/build-cli.sh",
    "build:sdk": "npm run build --prefix packages/sdk",
    "agent:service": "node dist/service/main.js",
    "weixin:login": "node dist/channels/weixin/login.js",
    "feishu:setup": "node dist/services/feishu/setup.js",
    "channels:check": "node dist/service/check-cli.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.1.0",
    "@larksuiteoapi/node-sdk": "1.74.0",
    "aws4fetch": "^1.0.20",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "grammy": "1.46.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.15",
    "matrix-js-sdk": "^42.3.0",
    "qrcode-terminal": "0.12.0",
    "undici": "^8.12.4",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.4",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "bin": {
    "agent-router-connector": "dist/matrix/index.js"
  },
  "files": [
    "dist",
    "docs/guides/*.md",
    "docs/architecture/communication-layer.md",
    "scripts/install.sh",
    "scripts/matrix",
    "README.md",
    "LICENSE",
    "src",
    "examples/echo-agent/src",
    "examples/echo-agent/package.json",
    "examples/echo-agent/tsconfig.json",
    "scripts/update-weixin-transport.py",
    "scripts/verify-agent-host.mjs",
    "scripts/verify-native-sessions.mjs",
    "scripts/fixtures/native-sessions-server.mjs",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  }
}
