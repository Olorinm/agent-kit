{
  "name": "@olorinm/agent-host",
  "version": "0.9.0-alpha.1",
  "description": "Product-independent native Agent sessions, tools and interaction routing",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Olorinm/agent-kit.git",
    "directory": "packages/host"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.zh-CN.md",
    "docs",
    "examples/file-editor/cli.mjs",
    "examples/file-editor/editor.mjs",
    "examples/file-editor/package.json",
    "examples/http-editor/app.js",
    "examples/http-editor/server.mjs",
    "examples/http-editor/index.html",
    "examples/http-editor/README.md",
    "examples/http-editor/package.json",
    "examples/http-editor/host.example.json",
    "plugins"
  ],
  "exports": {
    "./server": {
      "types": "./dist/service/index.d.ts",
      "import": "./dist/service/index.js"
    },
    "./client": {
      "types": "./dist/service/client.d.ts",
      "import": "./dist/service/client.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./codex": {
      "types": "./dist/codex/index.d.ts",
      "import": "./dist/codex/index.js"
    },
    "./acp": {
      "types": "./dist/acp/index.d.ts",
      "import": "./dist/acp/index.js"
    },
    "./claude": {
      "types": "./dist/claude/index.d.ts",
      "import": "./dist/claude/index.js"
    },
    "./pi": {
      "types": "./dist/pi/index.d.ts",
      "import": "./dist/pi/index.js"
    },
    "./hermes": {
      "types": "./dist/hermes/index.d.ts",
      "import": "./dist/hermes/index.js"
    },
    "./openclaw": {
      "types": "./dist/openclaw/index.d.ts",
      "import": "./dist/openclaw/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "import": "./dist/capabilities.js"
    },
    "./interactions": {
      "types": "./dist/interactions.d.ts",
      "import": "./dist/interactions.js"
    }
  },
  "bin": {
    "agent-host": "dist/service/cli.js",
    "agent-host-relay": "dist/service/relay-cli.js"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.300",
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "cross-spawn": "7.0.6",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@openai/codex": "0.166.0",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  }
}
