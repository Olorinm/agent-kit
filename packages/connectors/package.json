{
  "name": "@olorinm/agent-connectors",
  "version": "0.10.0-alpha.2",
  "description": "Business connectors for Agents: credentials, server-side authorization and approval-bound writes behind MCP",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Olorinm/agent-kit.git",
    "directory": "packages/connectors"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "guides",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.zh-CN.md",
    "docs"
  ],
  "allowScripts": {
    "@larksuite/cli@1.0.97": true,
    "agent-browser@0.41.2": false
  },
  "exports": {
    "./guides": {
      "types": "./dist/guides.d.ts",
      "import": "./dist/guides.js"
    },
    "./read-client": {
      "types": "./dist/read-client.d.ts",
      "import": "./dist/read-client.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./issuer": {
      "types": "./dist/issuer.d.ts",
      "import": "./dist/issuer.js"
    },
    "./feishu-bot-reader": {
      "types": "./dist/feishu-bot-reader.d.ts",
      "import": "./dist/feishu-bot-reader.js"
    },
    "./cloudflare-read-client": {
      "types": "./dist/cloudflare-read-client.d.ts",
      "import": "./dist/cloudflare-read-client.js"
    }
  },
  "bin": {
    "agent-connectors": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@google-cloud/kms": "6.3.0",
    "@googleapis/calendar": "^20.1.0",
    "@googleapis/docs": "^14.1.1",
    "@googleapis/drive": "^27.0.0",
    "@googleapis/gmail": "^22.0.2",
    "@googleapis/sheets": "^18.1.2",
    "@googleapis/slides": "^10.1.1",
    "@larksuite/cli": "1.0.97",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "agent-browser": "0.41.2",
    "gaxios": "^8.3.2",
    "google-auth-library": "^11.3.3",
    "html-to-text": "^10.0.1",
    "jose": "^6.2.16",
    "nodemailer": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
